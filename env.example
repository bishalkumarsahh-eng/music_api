# Required before exposing the API publicly.
API_KEY=change-this-to-a-long-random-key

PORT=8000
DOWNLOAD_DIR=downloads
DB_FILE=velocitybots.db

# 0 keeps successful downloads cached until the file is removed.
CACHE_EXPIRE_HOURS=0
MAX_VIDEO_QUALITY=720
CONCURRENT_FRAGMENT_DOWNLOADS=30
HTTP_CHUNK_SIZE=10485760
SOCKET_TIMEOUT=20
RETRIES=3
FRAGMENT_RETRIES=3
AUDIO_QUALITY=192
CORS_ORIGINS=*

# Set this when the API is behind a public domain or reverse proxy.
# It makes download_url/url in /download responses usable by Telegram bots.
# PUBLIC_BASE_URL=https://api.example.com

# Optional YouTube cookies URL. Keep cookies out of git.
# COOKIE_URL=
# COOKIE_FILE=cookies.txt