# Required
API_KEY=replace-with-a-long-random-secret

# YouTube authentication
# Set USE_COOKIES=true when you provide valid YouTube cookies.
USE_COOKIES=true
# Provide ONE of these. COOKIE_BASE64 is the most reliable on Heroku.
COOKIE_BASE64=
COOKIE_URL=
COOKIE_FILE_URL=
DEBUG_ERRORS=false

# Storage / cache
DOWNLOAD_DIR=downloads
CACHE_EXPIRE_HOURS=0

# Video endpoint
MAX_VIDEO_QUALITY=720

# Download performance
CONCURRENT_FRAGMENT_DOWNLOADS=15
HTTP_CHUNK_SIZE=10485760
SOCKET_TIMEOUT=15
RETRIES=3
FRAGMENT_RETRIES=3

# Leave as "default" unless you have a specific yt-dlp client requirement.
YOUTUBE_PLAYER_CLIENTS=default

# Optional fast upstream for /stream.
REMOTE_API_URL=
REMOTE_API_KEY=
REMOTE_CONNECT_TIMEOUT=5
REMOTE_READ_TIMEOUT=300
REMOTE_CHUNK_SIZE=65536
